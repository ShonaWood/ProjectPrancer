\f0\b \cf0 Compile paml programs and executables:\

\f1\b0 cd src\
make\
ls -1F\
rm *.o\
mv baseml basemlg codeml pamp evolver yn00 chi2 ../bin\
cd ..\
bin/codeml\
\

\f0\b Make a new working directory for each opsin:\

\f1\b0 Cd emerflanagan/Desktop\
mkdir ~/codeml_OPN1SW\
cd ~/codeml_OPN1SW\
\

\f0\b Control (.ctl files) can be found in src, and copied to the working bin directory\
\

\f1\b0 \

\f0\b Convert FASTA file to PHYLIP file format\

\f1\b0 seqmagick convert alignment.fasta alignment.phy\
seqmagick convert alignment.phy output.phy --output-format phylip-sequential\
\

\f0\b Might have to add spaces\

\f1\b0 sed -E 's/^([A-Za-z0-9_]+) /\\1  /' output.phy > output_fixed.phy\
\

\f0\b Make new control file and save, but be sure to remove any hidden .txt extensions\

\f1\b0 mv M812378_codeml.ctl.txt M812378_codeml.ctl\
\

\f0\b Will likley run into tree format issues (always bracket problems), so check the number of opening brackets matches the number of closing brackets\

\f1\b0 grep -o "(" species_tree.tree | wc -l\
grep -o ")" species_tree.tree | wc -l\
\

\f0\b Also opening the tree file in TreeViewer makes it easier to visually catch polygamy (caused by wrong brackets)
